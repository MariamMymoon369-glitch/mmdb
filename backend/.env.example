# Backend server
PORT=3000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mmdb
DB_PASSWORD=your-database-password
DB_DATABASE=mmdb2
# Set to true when the server requires TLS (e.g. Neon, Render Postgres)
DB_SSL=false
# Set to false to skip TypeORM migrations on startup (recommended for hosted databases)
DB_RUN_MIGRATIONS=true

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# TMDB (set TMDB_READ_TOKEN for v4 auth or TMDB_API_KEY for v3 auth)
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Optional: include the demo seed accounts when NODE_ENV=production.
# Demo accounts are created automatically outside production.
# SEED_DEMO_USERS=true
